{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // The Renovate maintainers' own preset rather than a hand-picked list.
  // Pinning action digests is the part that matters most here. Actions are
  // referenced by commit SHA rather than by tag, because a tag is mutable and
  // these workflows carry a Supermarket signing key: whoever controls an
  // action can move v7 to point at anything, and nothing in a diff would show
  // it. The preset rewrites the SHA and the trailing version comment
  // together, so the readable version never drifts from the pin.
  "extends": ["config:best-practices"],

  "timezone": "America/Denver",

  // The whole day rather than a few hours of it. The schedule only gates
  // what Renovate does when it happens to run, and the hosted app can run a
  // repository as rarely as once a day at a time of its choosing, so a
  // narrow window can go unvisited for weeks with updates waiting.
  //
  // Sunday so that the window has closed by the time the pull requests are
  // reviewed. Merging one while the window is still open frees its branch,
  // and the next run opens another for whatever was released in between,
  // which for a dependency that releases several times a day is a chain of
  // pull requests rather than one.
  "schedule": ["on sunday"],

  // Stated rather than left to detection. Renovate infers the style from
  // history, and this repository writes plain imperative subjects, so it
  // should land here by itself. Saying so means a change in how detection
  // works cannot start writing chore(deps) subjects into a log that has never
  // had them, which matters because pull requests are squashed and the title
  // becomes the subject on main.
  "semanticCommits": "disabled",

  "labels": ["dependencies"],

  "packageRules": [
    {
      // One pull request for everything. There are only a handful of
      // dependencies here, so separate pull requests would be noise and a CI
      // run apiece rather than one.
      "matchPackageNames": ["*"],
      "groupName": "dependencies"
    },
    {
      // Only the version is taken from this image: CI installs the package,
      // not the image, so there is no digest to pin, and the files carrying
      // the version have nowhere to put one.
      "matchPackageNames": ["cincproject/workstation"],
      "pinDigests": false
    }
  ],

  // The Cinc Workstation version CI installs. It is a plain input default
  // rather than anything a package manager knows about, so the comment above
  // it is what marks it as a dependency.
  //
  // TESTING.md states the same version, so it carries the same marker and is
  // updated in the same pull request: both resolve to one dependency at one
  // version, which Renovate puts on a single branch.
  //
  // The pattern is deliberately shape-agnostic, "the marker line, then the
  // first version on the next line", so that it reads a YAML comment and a
  // Markdown comment without caring which file it is in.
  "customManagers": [
    {
      // The containers the lint job runs, marked the same
      // way as the Cinc pin above: a marker line naming the datasource and the
      // image, then the first version on the line below it.
      //
      // The leading v is part of the version and has to be captured with it.
      // A docker tag is whatever the publisher called it, and these three do
      // not agree: shellcheck publishes v0.11.0 while actionlint publishes
      // 1.7.12. Capturing the digits alone sent Renovate to look up a tag
      // that does not exist, which fails as "could not determine new digest"
      // on the dashboard rather than as anything red, so the pin silently
      // stopped being maintained while the check here still passed.
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/scripts/check-renovate$/",
        "/^\\.github/scripts/check-shell$/",
        "/^\\.github/scripts/check-workflows$/"
      ],
      "matchStrings": ["renovate: docker (?<depName>\\S+)[^\\n]*\\n[^\\n]*?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)[^\\n]*\\n[^\\n]*?(?<currentDigest>sha256:[0-9a-f]{64})"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      // New versions are read from the Cinc project's cincproject/workstation
      // image tags on Docker Hub, although CI installs the package from
      // omnitruck. The image is built from the stable package once it is
      // deployed, so every tag is a version omnitruck can install, and Docker
      // Hub reports when each tag was pushed, which omnitruck does not. If
      // the project stopped publishing the image, updates would stop with it.
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/actions/setup-cinc/action\\.yml$/",
        "/^TESTING\\.md$/"
      ],
      "matchStrings": ["renovate: cinc-workstation[^\\n]*\\n[^\\n]*?(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "cincproject/workstation",
      "versioningTemplate": "semver"
    }
  ]
}
