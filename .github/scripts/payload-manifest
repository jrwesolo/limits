#!/usr/bin/env bash
#
# Prints what a given commit would publish, one `sha<TAB>path` line per file,
# sorted. The sha is git's own blob hash, so two manifests compare equal only
# when the published bytes are identical.
#
# What counts as published is decided by that commit's own chefignore, read
# through the same class Chef uses when it builds the tarball. Nothing here
# names a path or a directory: add a file to the cookbook, or a line to
# chefignore, and this follows without an edit.
#
# Expects one argument, a commit-ish. Run it from the root of a checkout.

set -euo pipefail

: "${1:?must be given a commit to describe}"

exec cinc exec ruby - "$1" <<'RUBY'
require 'pathname'
require 'tmpdir'
require 'chef/cookbook/chefignore'

ref = ARGV[0]

# The chefignore that belongs to this commit, not the one checked out. A
# commit that changes chefignore changes what it publishes, and that has to
# be visible here or the comparison misses it entirely.
# Fail rather than guess. Without this commit's chefignore there is no
# answer to give, and returning "nothing is ignored" would report the whole
# tree as published and call every pull request a payload change.
ignore = `git show #{ref}:chefignore`
abort "cannot read chefignore at #{ref}" unless $?.success?

# -z, so paths arrive exactly as git stores them. Without it git C-quotes
# any path holding a space, a quote, or a non-ASCII byte, and the quoted
# spelling would be compared against the unquoted one from the other side.
records = `git ls-tree -r -z #{ref}`
abort "cannot list the tree at #{ref}" unless $?.success?

entries = records.split("\0").reject(&:empty?).filter_map do |record|
  meta, path = record.split("\t", 2)
  _mode, type, sha = meta.to_s.split(' ')

  # Only blobs are published. A submodule appears here as a commit entry
  # and has no content of its own in this tree. Anything without all three
  # parts is not an entry at all, and silently became a blank line in the
  # manifest before, which read as a difference that did not exist.
  [path, sha] if type == 'blob' && !sha.nil? && !path.nil?
end

Dir.mktmpdir do |dir|
  File.write(File.join(dir, 'chefignore'), ignore)
  chefignore = Chef::Cookbook::Chefignore.new(dir)

  entries.reject { |path, _| chefignore.ignored?(path) }
         .sort
         .each { |path, sha| puts "#{sha}\t#{path}" }
end
RUBY
