#!/usr/bin/env bash
#
# Checks that a pull request which bumps the cookbook version proposes a
# version that can actually be released: one that is not already tagged, and
# one that is documented as the newest entry in the changelog.
#
# Both checks are skipped when the version is unchanged from the base branch,
# so documentation-only pull requests are unaffected.
#
# Expects BASE_REF, GITHUB_REPOSITORY and GH_TOKEN in the environment. Run it
# from the root of a checkout.

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib.bash"

: "${BASE_REF:?must be set to the pull request base branch}"
: "${GITHUB_REPOSITORY:?must be set to owner/repo}"

version="$(cookbook_version)"
if [[ -z ${version} ]]; then
  echo "::error file=metadata.rb::Could not parse the version."
  exit 1
fi

git fetch --quiet --depth=1 origin "${BASE_REF}"
base_version="$(cookbook_version <(git show FETCH_HEAD:metadata.rb))"

echo "metadata.rb: ${version} (${BASE_REF}: ${base_version})"

# What this commit would publish, against what the base branch publishes.
# Anything a user downloads that is not identical has to arrive under a
# version of its own, or it lands on the base branch attributed to a version
# that was released without it.
manifest() {
  "$(dirname "${BASH_SOURCE[0]}")/payload-manifest" "$1"
}

if [[ ${version} == "${base_version}" ]]; then
  published_diff="$(diff <(manifest FETCH_HEAD) <(manifest HEAD) || true)"

  if [[ -n ${published_diff} ]]; then
    echo "::error file=metadata.rb::The published cookbook changes but the \
version does not. Bump it, or keep the change out of the tarball."
    echo "Files that differ in what would be published:"
    printf '%s\n' "${published_diff}" | sed -n 's/^[<>] [0-9a-f]*\t/  /p' | sort -u
    exit 1
  fi

  echo "Version unchanged, and nothing that would be published changed."
  exit 0
fi

if tag_exists "v${version}"; then
  echo "::error file=metadata.rb::v${version} is already tagged. Pick an unreleased version."
  exit 1
fi

# The first version-shaped line in the file is the newest section heading. The
# capture stops at the closing bracket, so anything appended after it makes no
# difference to the match.
newest=''
while IFS= read -r line; do
  if [[ ${line} =~ ^\[(v[0-9]+\.[0-9]+\.[0-9]+)\] ]]; then
    newest="${BASH_REMATCH[1]}"
    break
  fi
done < CHANGELOG.md

if [[ ${newest} != "v${version}" ]]; then
  echo "::error file=CHANGELOG.md::Newest entry is '${newest:-none}', expected 'v${version}'."
  exit 1
fi

if ! grep -qF "[v${version}]: " CHANGELOG.md; then
  echo "::error file=CHANGELOG.md::Missing the link reference for [v${version}]."
  exit 1
fi

echo "v${version} is unreleased and is the newest changelog entry."
