#!/usr/bin/env bash
#
# Checks that a pull request which bumps the cookbook version proposes a
# version that can actually be released: one that is not already tagged, and
# one that is documented as the newest entry in the changelog.
#
# Both checks are skipped when the version is unchanged from the base branch.
# The check that applies instead is that nothing published changes, so a
# documentation-only pull request passes and a change users would download
# does not.
#
# Either way it lists what the published cookbook gains, loses and changes
# against the base branch, in the log and in the job summary, so a version
# bump shows exactly which files the eventual artifact differs by.
#
# Expects BASE_REF, GITHUB_REPOSITORY and GH_TOKEN in the environment. Run it
# from the root of a checkout.

set -euo pipefail

# shellcheck source=.github/scripts/lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/lib.bash"

: "${BASE_REF:?must be set to the pull request base branch}"
: "${GITHUB_REPOSITORY:?must be set to owner/repo}"

# Tested in the condition, because cookbook_version returns non-zero when it
# finds no declaration and set -e would otherwise abort the script on the
# assignment itself, before the message below could be printed. A bare red job
# with no annotation is a worse answer than a wrong one.
if ! version="$(cookbook_version)" || [[ -z ${version} ]]; then
  echo "::error file=metadata.rb::Could not parse the version."
  exit 1
fi

# gc.auto off for the fetch. git schedules a detached gc after a clone or a
# fetch, the checkout step has already done one, and that gc rewrites
# .git/shallow underneath a `--depth=1` fetch running at the same time. The
# fetch then dies with "shallow file has changed since we read it", which is a
# red job saying nothing about the cookbook. Measured locally at six failures
# in six runs with it on, none with it off.
#
# Tested rather than left to set -e. A fetch that fails ends the script either
# way, but without this the job goes red carrying git's message and no
# annotation, which is the shape this file exists to stop. git's own wording
# is the useful part, so it is carried into the annotation rather than thrown
# away.
if ! fetched="$(git -c gc.auto=0 fetch --quiet --depth=1 origin "${BASE_REF}" 2>&1)"; then
  echo "::error::Could not fetch ${BASE_REF} to compare against: ${fetched}"
  exit 1
fi
if ! base_version="$(cookbook_version <(git show FETCH_HEAD:metadata.rb))" ||
  [[ -z ${base_version} ]]; then
  echo "::error file=metadata.rb::Could not parse the version on ${BASE_REF}."
  exit 1
fi

echo "metadata.rb: ${version} (${BASE_REF}: ${base_version})"

# What a commit would publish, one manifest entry per line.
# Keeps only what looks like a manifest entry: a sha, a tab, a path.
# Anything else reaching stdout is noise from the toolchain rather than
# part of the answer, and a stray blank line compared as a difference that
# did not exist. Assigned before filtering so that a failure to build the
# manifest still aborts under set -e.
manifest() {
  local raw line out=''

  raw="$("$(dirname "${BASH_SOURCE[0]}")/list-payload" "$1")"

  while IFS= read -r line; do
    [[ ${line} == *$'\t'* ]] || continue
    out+="${line}"$'\n'
  done <<<"${raw}"

  printf '%s' "${out}"
}

# Prints how many lines a blob holds, as git counts them, or "binary" when git
# would not diff it as text. Written to a file and compared against /dev/null,
# because git will not diff a blob against the empty blob unless the empty blob
# is stored, and a checkout need not store it. That also keeps the text or
# binary decision git's own rather than a guess made here.
#
# Every failure returns non-zero explicitly. This runs inside a command
# substitution, which set -e does not reach in bash 3.2.
blob_lines() {
  local tmp stat rc=0 added deleted

  tmp="$(mktemp)" || return 1
  if ! git cat-file -p "$1" > "${tmp}"; then
    rm -f "${tmp}"
    return 1
  fi
  # Exits 1 when the two differ, which for a non-empty blob is always.
  stat="$(git diff --no-index --numstat /dev/null "${tmp}")" || rc=$?
  rm -f "${tmp}"
  ((rc <= 1)) || return 1

  # numstat prints lines added, lines deleted and the path, or a dash for
  # each count when git reads the file as binary. Nothing at all for an
  # empty blob, which has no lines to add.
  read -r added deleted _ <<<"${stat}"
  if [[ -z ${stat} ]]; then
    printf "0"
  elif [[ ${added} =~ ^[0-9]+$ && ${deleted} == 0 ]]; then
    printf "%s" "${added}"
  elif [[ ${added} == - && ${deleted} == - ]]; then
    printf "binary"
  else
    return 1
  fi
}

# Prints one tab separated line per published file that differs between two
# manifests: added, removed or modified, the path, and a size. An added file
# is sized by the lines it brings and a removed one by the lines it takes
# away, since lines changed in git would describe the file's history rather
# than what the tarball gains or loses. A modified one is sized by lines added
# and removed. A binary file says so instead.
#
# Both manifests arrive sorted by path from list-payload, which sorts bytewise,
# so they are walked side by side, compared in the C locale to agree with that
# order. Indexed arrays rather than an associative one, to stay within bash 3.2.
payload_changes() {
  local base_ref=$1 head_ref=$2 LC_ALL=C
  local -a base_paths=() base_shas=() head_paths=() head_shas=()
  local sha path i=0 j=0 lines stat added deleted

  while IFS=$'\t' read -r sha path; do
    base_shas+=("${sha}")
    base_paths+=("${path}")
  done <<<"$3"
  while IFS=$'\t' read -r sha path; do
    head_shas+=("${sha}")
    head_paths+=("${path}")
  done <<<"$4"

  while ((i < ${#base_paths[@]} || j < ${#head_paths[@]})); do
    if ((j >= ${#head_paths[@]})) ||
      { ((i < ${#base_paths[@]})) && [[ ${base_paths[i]} < ${head_paths[j]} ]]; }; then
      lines="$(blob_lines "${base_shas[i]}")" || return 1
      [[ ${lines} == binary ]] || lines="-${lines}"
      printf "removed\t%s\t%s\n" "${base_paths[i]}" "${lines}"
      i=$((i + 1))
    elif ((i >= ${#base_paths[@]})) || [[ ${head_paths[j]} < ${base_paths[i]} ]]; then
      lines="$(blob_lines "${head_shas[j]}")" || return 1
      [[ ${lines} == binary ]] || lines="+${lines}"
      printf "added\t%s\t%s\n" "${head_paths[j]}" "${lines}"
      j=$((j + 1))
    else
      if [[ ${base_shas[i]} != "${head_shas[j]}" ]]; then
        stat="$(git diff --numstat "${base_ref}" "${head_ref}" -- ":(literal)${head_paths[j]}")" ||
          return 1
        read -r added deleted _ <<<"${stat}"
        if [[ ${added} =~ ^[0-9]+$ && ${deleted} =~ ^[0-9]+$ ]]; then
          printf "modified\t%s\t+%s -%s\n" "${head_paths[j]}" "${added}" "${deleted}"
        elif [[ ${added} == - && ${deleted} == - ]]; then
          printf "modified\t%s\tbinary\n" "${head_paths[j]}"
        else
          return 1
        fi
      fi
      i=$((i + 1))
      j=$((j + 1))
    fi
  done
}

# Into variables rather than straight into diff, so that a manifest which
# fails to build aborts here. Compared as process substitutions, a broken
# list-payload yields two empty streams, diff calls them equal, and the check
# passes while guarding nothing.
base_published="$(manifest FETCH_HEAD)"
head_published="$(manifest HEAD)"

# Every cookbook publishes at least its metadata, so an empty manifest is a
# broken one rather than a cookbook with nothing in it.
if [[ -z ${base_published} || -z ${head_published} ]]; then
  echo "::error file=chefignore::Could not determine what would be published."
  exit 1
fi

# Whether anything changed is decided by the manifests, never by the
# description of them. If describing them fails, or yields nothing while the
# manifests differ, the description is what is broken, and a change it failed
# to describe must not pass for no change at all, so the raw difference is
# printed instead. Tested in the condition, so set -e cannot end the script
# on the assignment before the annotation is written.
if ! changes="$(payload_changes FETCH_HEAD HEAD "${base_published}" "${head_published}")" ||
  [[ ${base_published} != "${head_published}" && -z ${changes} ]]; then
  echo "::error::The published cookbook changes, but the changes could not be described."
  diff <(printf '%s\n' "${base_published}") <(printf '%s\n' "${head_published}") || true
  exit 1
fi

base_count="$(grep -c . <<<"${base_published}")"
head_count="$(grep -c . <<<"${head_published}")"

echo "Published files: ${BASE_REF} has ${base_count}, this has ${head_count}."
add_summary '### Published cookbook' '' \
  "\`${BASE_REF}\` publishes ${base_count} files, this pull request publishes ${head_count}." ''

if [[ -z ${changes} ]]; then
  echo "  No published file changes."
  add_summary 'No published file changes.' ''
else
  add_summary '| Change | File | Lines |' '| --- | --- | --- |'
  while IFS=$'\t' read -r kind path size; do
    printf '  %-9s %-28s %s\n' "${kind}" "${path}" "${size}"
    add_summary "| ${kind} | \`${path//|/\\|}\` | ${size} |"
  done <<<"${changes}"
  add_summary ''
fi

if [[ ${version} == "${base_version}" ]]; then
  # Anything a user downloads that is not identical has to arrive under a
  # version of its own, or it lands on the base branch attributed to a version
  # that was released without it.
  if [[ -n ${changes} ]]; then
    echo "::error file=metadata.rb::The published cookbook changes but the \
version does not. Bump it, or keep the change out of the tarball."
    exit 1
  fi

  echo "Version unchanged, and nothing that would be published changed."
  exit 0
fi

if tag_exists "v${version}"; then
  echo "::error file=metadata.rb::v${version} is already tagged. Pick an unreleased version."
  exit 1
fi

# The first version-shaped line in the file is the newest section heading. The
# capture stops at the closing bracket, so anything appended after it makes no
# difference to the match.
newest=''
while IFS= read -r line; do
  if [[ ${line} =~ ^\[(v[0-9]+\.[0-9]+\.[0-9]+)\] ]]; then
    newest="${BASH_REMATCH[1]}"
    break
  fi
done < CHANGELOG.md

if [[ ${newest} != "v${version}" ]]; then
  echo "::error file=CHANGELOG.md::Newest entry is '${newest:-none}', expected 'v${version}'."
  exit 1
fi

if ! grep -qF "[v${version}]: " CHANGELOG.md; then
  echo "::error file=CHANGELOG.md::Missing the link reference for [v${version}]."
  exit 1
fi

echo "v${version} is unreleased and is the newest changelog entry."
