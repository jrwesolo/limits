#!/usr/bin/env bash
#
# Runs shellcheck over every shell script in the repository.
#
# What counts as one is decided by looking rather than by a list: any tracked
# file whose first line names bash, plus anything ending in .bash, which is how
# a library meant to be sourced is spelled here since it carries no shebang of
# its own. A list would be one more thing to remember when a script is added,
# and the first symptom of forgetting would be a lint quietly checking less
# than it did the day before.
#
# Run it from the root of a checkout.

set -euo pipefail

# renovate: docker koalaman/shellcheck
version=v0.11.0
digest=sha256:61862eba1fcf09a484ebcc6feea46f1782532571a34ed51fedf90dd25f925a8d

if ! command -v docker >/dev/null; then
  echo "::error::docker is required to run the pinned shellcheck."
  exit 1
fi

files=()
while IFS= read -r -d '' file; do
  [[ -f ${file} ]] || continue

  case ${file} in
    *.bash)
      files+=("${file}")
      continue
      ;;
  esac

  read -r first < "${file}" || continue
  [[ ${first} == '#!'*bash* ]] && files+=("${file}")
done < <(git ls-files -z)

# Nothing found means the detection broke, not that the repository stopped
# carrying scripts, and a lint that checks nothing must not report success.
if ((${#files[@]} == 0)); then
  echo "::error::No shell scripts found to check."
  exit 1
fi

echo "Checking ${#files[@]} shell scripts:"
printf '  %s\n' "${files[@]}"

# In a pinned container rather than against whatever the machine happens to
# carry. The runner images ship a shellcheck of their own, and it disagreed
# with a developer's: a finding that was clean locally failed the build, which
# is the worst way to learn a lint is not reproducible.
#
# -x so that a sourced library is followed and checked alongside its callers.
docker run --rm --volume "${PWD}:/mnt" --workdir /mnt \
  "koalaman/shellcheck:${version}@${digest}" -x -s bash "${files[@]}"
