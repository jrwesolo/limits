#!/usr/bin/env bash
#
# Validates the Renovate configuration, and checks that every file claiming to
# carry a dependency still yields one.
#
# The configuration's custom managers are regexes over other files, and a
# regex that stops matching fails silently: Renovate proposes nothing, the
# pinned versions quietly stop being maintained, and nothing anywhere turns
# red. Extracting with Renovate itself and asserting that each marked file
# still produces a dependency is what makes that a failure instead.
#
# It also fails on configuration Renovate would refuse, which the validator
# does not catch. renovate-config-validator checks the configuration's shape,
# but a version constraint is only parsed against its versioning scheme when a
# dependency is looked up, so a packageRule such as allowedVersions "<26.04" on
# a docker-versioned dependency validates cleanly here and then stops every
# update in the repository. Renovate reports that as a problem and still exits
# zero, so the report is read for it.
#
# That means a lookup rather than extraction alone, so this touches the
# network. What a registry answers decides nothing here: proposed updates are
# ignored, and a lookup that fails only leaves that dependency's rules
# unchecked for the run rather than turning the check red. GitHub-hosted
# dependencies need RENOVATE_GITHUB_COM_TOKEN to be looked up at all. CI
# passes the workflow token and fails without one; by hand it is optional,
# and without it those lookups are skipped with a warning.
#
# Run it from the root of a checkout.

set -euo pipefail

# renovate: docker ghcr.io/renovatebot/renovate
version=44.108.2
digest=sha256:9a02c0e89a1337fed22b40b01a0c9b212e947eff37e8a1bd0d3696bfe5a0b344

if ! command -v docker >/dev/null; then
  echo "::error::docker is required to run the pinned Renovate."
  exit 1
fi

if [[ -z ${RENOVATE_GITHUB_COM_TOKEN:-} ]]; then
  if [[ ${GITHUB_ACTIONS:-} == true ]]; then
    echo "::error::RENOVATE_GITHUB_COM_TOKEN is not set, so GitHub-hosted dependencies would not be looked up."
    exit 1
  fi
  echo "::warning::RENOVATE_GITHUB_COM_TOKEN is not set, so rules for GitHub-hosted dependencies go unchecked."
fi

image="ghcr.io/renovatebot/renovate:${version}@${digest}"

out="$(mktemp -d)"
trap 'rm -rf "${out}"' EXIT
# The container runs as its own user, so the directory it writes the report
# into has to be writable by somebody other than whoever created it.
chmod 0777 "${out}"

echo "Validating the configuration"
docker run --rm --volume "${PWD}:/repo:ro" --workdir /repo \
  --entrypoint renovate-config-validator "${image}"

# Named rather than given a value, so docker passes the token through from
# this environment and it never appears on a command line.
echo "Looking up dependencies"
docker run --rm \
  --volume "${PWD}:/repo:ro" \
  --volume "${out}:/out" \
  --workdir /repo \
  --env RENOVATE_PLATFORM=local \
  --env RENOVATE_DRY_RUN=lookup \
  --env RENOVATE_GITHUB_COM_TOKEN \
  --env RENOVATE_REPORT_TYPE=file \
  --env RENOVATE_REPORT_PATH=/out/report.json \
  "${image}" >/dev/null

if [[ ! -s ${out}/report.json ]]; then
  echo "::error::Renovate produced no report."
  exit 1
fi

# Before anything is read out of the report, because a configuration Renovate
# refuses comes back with no package files at all, and the check below would
# then blame extraction for what is really the configuration. Keyed on the
# error Renovate attaches, not on the wording of its log line.
# Each is printed with Renovate's own explanation, which names the setting and
# the value it could not parse.
refused="$(jq -r '[.problems[]?, .repositories[].problems[]?]
  | map(select(.err.validationSource == "config"))
  | unique_by(.err.validationMessage)[]
  | "\(.err.validationError): \(.err.validationMessage)"' "${out}/report.json")"

if [[ -n ${refused} ]]; then
  while IFS= read -r line; do
    printf '::error file=.github/renovate.jsonc::Renovate would refuse this configuration. %s\n' "${line}"
  done <<<"${refused}"
  exit 1
fi

extracted="$(jq -r '.repositories[].packageFiles | to_entries[] | .value[].packageFile' \
  "${out}/report.json" | sort -u)"

if [[ -z ${extracted} ]]; then
  echo "::error file=.github/renovate.jsonc::Renovate extracted no dependencies at all."
  exit 1
fi

# Two rules, because each catches what the other cannot.
#
# The first is that every file carrying a marker must yield a dependency,
# which catches a pattern in the configuration that has stopped matching what
# it was written for.
#
# The second is that every file pinning something by digest must yield one
# too, which catches the opposite mistake: a marker deleted or misspelled,
# where searching for markers alone would stop looking at the file and report
# success. The digest stays behind even when the marker does not.
#
# Both are discovered by looking rather than from a list here, so a new
# dependency is covered without an edit. What neither covers is a marker
# deleted from a dependency with no distinctive shape to search for, such as a
# plain version string in documentation.
# The configuration itself is excluded from both searches: it carries the
# marker's own text inside the pattern that looks for it.
config='^\.github/renovate\.'

# Captured before either loop, rather than read from a process substitution,
# so that a search which fails or finds nothing is a failure here. Read
# directly into a loop, a broken search yields no iterations, nothing is
# checked, and the check reports success.
if ! marked="$(git grep -lE '(#|<!--) renovate:' -- . | grep -vE "${config}" | sort -u)" ||
  [[ -z ${marked} ]]; then
  echo "::error::No file carries a Renovate marker, so either the search or the convention changed."
  exit 1
fi

# The shapes that actually pin something, rather than any sha256 anywhere: a
# digest quoted in documentation is not a dependency, and demanding that
# Renovate track it would fail the build for prose.
if ! pinned="$(git grep -lE '(@|digest=)sha256:[0-9a-f]{64}' -- . | grep -vE "${config}" | sort -u)" ||
  [[ -z ${pinned} ]]; then
  echo "::error::Nothing is pinned by digest, so either the search or the convention changed."
  exit 1
fi

missing=0

# Both rules ask the same question of a different list, so it is asked in one
# place. Fed by redirection rather than by a pipeline, which would run the loop
# in a subshell and lose the count.
each_must_be_extracted() {
  local found=$1 complaint=$2 list=$3 file

  while IFS= read -r file; do
    if grep -qxF "${file}" <<<"${extracted}"; then
      printf '  %-44s %s\n' "${file}" "${found}"
    else
      printf '::error file=%s::%s\n' "${file}" "${complaint}"
      missing=1
    fi
  done <<<"${list}"
}

each_must_be_extracted 'dependency found' \
  'Carries a Renovate marker but yields no dependency.' "${marked}"

each_must_be_extracted 'digest pin tracked' \
  'Pins something by digest that Renovate does not track.' "${pinned}"

if ((missing)); then
  exit 1
fi

echo "Configuration is valid and accepted on lookup, and every marked file still yields a dependency."
