#!/usr/bin/env bash
#
# Tags the current commit and publishes a GitHub release for the version in
# metadata.rb, using that version's changelog section as the release notes.
#
# Idempotent by design: if the version is already tagged the script exits 0
# without publishing, so a merge that does not bump the version is a no-op.
# This is the mirror image of check-version, which fails a pull request when
# the tag already exists.
#
# Expects GITHUB_REPOSITORY, GITHUB_SHA and GH_TOKEN in the environment. Run it
# from the root of a checkout.

set -euo pipefail

# shellcheck source=.github/scripts/lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/lib.bash"

: "${GITHUB_REPOSITORY:?must be set to owner/repo}"
: "${GITHUB_SHA:?must be set to the commit to tag}"

# Tested in the condition, because cookbook_version returns non-zero when it
# finds no declaration, and set -e would otherwise end the script on the
# assignment itself, before the message below could be printed.
if ! version="$(cookbook_version)" || [[ -z ${version} ]]; then
  echo "::error file=metadata.rb::Could not parse the version."
  exit 1
fi

tag="v${version}"
release_url="${GITHUB_SERVER_URL:-https://github.com}/${GITHUB_REPOSITORY}/releases/tag/${tag}"

if tag_exists "${tag}"; then
  echo "${tag} is already tagged, nothing to release."
  add_summary "### Release" "" \
    "[\`${tag}\`](${release_url}) is already tagged, so nothing was released." ""
  set_output released=false
  exit 0
fi

notes="$(changelog_notes "${tag}")"
if [[ -z ${notes} ]]; then
  echo "::error file=CHANGELOG.md::No changelog section found for ${tag}."
  exit 1
fi

echo "Releasing ${tag} at ${GITHUB_SHA}"
printf '%s\n' "${notes}" | gh release create "${tag}" \
  --target "${GITHUB_SHA}" \
  --title "${tag}" \
  --notes-file -

# The notes go in collapsed, so the run says what shipped without a click
# through to the release, and without pushing anything below them out of view.
add_summary "### Release" "" \
  "Released [\`${tag}\`](${release_url}) at \`${GITHUB_SHA:0:7}\`." "" \
  "<details><summary>Release notes</summary>" "" "${notes}" "" "</details>" ""

# Publishing to Supermarket keys off this rather than repeating the tag check,
# so that a merge which releases nothing does not queue a deployment approval.
set_output released=true
